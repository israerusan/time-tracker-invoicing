{
	"name": "time-tracker-invoicing",
	"version": "1.0.2",
	"description": "Track billable time against notes/projects and generate invoices — for freelancers and consultants. Fully local.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "tsc --noEmit -p . && eslint . --max-warnings 0",
		"test": "npm run lint && node tests/license.test.mjs && node tests/manifest-contract.test.mjs",
		"test:ci": "node tests/license.test.mjs && node tests/manifest-contract.test.mjs",
		"license:generate": "node scripts/generate-license.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"time-tracking",
		"invoicing",
		"freelance",
		"billable"
	],
	"author": "iavil",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.0.0",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "1.7.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.62.1"
	},
	"dependencies": {
		"tweetnacl": "^1.0.3"
	}
}
