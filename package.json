{
	"name": "time-tracker-invoicing",
	"version": "1.0.0",
	"description": "Track billable time against notes/projects and generate invoices — for freelancers and consultants. Fully local.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "node tests/license.test.mjs",
		"license:generate": "node scripts/generate-license.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"time-tracking",
		"invoicing",
		"freelance",
		"billable"
	],
	"author": "iavil",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.0.0",
		"esbuild": "^0.28.1",
		"obsidian": "1.7.2",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"tweetnacl": "^1.0.3"
	}
}
